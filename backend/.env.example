PORT=8000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dr-screening?retryWrites=true&w=majority
# REQUIRED. Minimum 32 characters. The server refuses to start on a known
# placeholder or a short value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
ML_API_URL=http://localhost:8001
ML_TIMEOUT_MS=45000

# Development stub ONLY. When true, screenings return a fixed synthetic
# placeholder flagged isMock:true in the database and in the UI. It is
# refused outright when NODE_ENV=production. Leave false to use the model.
USE_MOCK_ML=false
# Not currently used — no cloudinary or LLM SDK is installed. Images are
# stored on local disk under backend/uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# LLM_API_KEY=
NODE_ENV=development

# Development only. The in-memory fallback store holds seeded accounts with a
# published password and is force-disabled when NODE_ENV=production regardless
# of this value. Set to false to exercise the production code path locally.
ALLOW_DEV_STORE=true
